# Included before project() so compiler detection uses the actual engine ABI.
cmake_policy(SET CMP0091 NEW)
set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>")
option(METAMOD_64BIT "Compile as 64-bit (for 64-bit engines such as HLND2T)" OFF)
if(CMAKE_HOST_UNIX AND NOT CMAKE_CROSSCOMPILING)
    if(METAMOD_64BIT)
        set(_mmfg_arch_flag " -m64")
    else()
        set(_mmfg_arch_flag " -m32")
    endif()
    foreach(flag CMAKE_C_FLAGS_INIT CMAKE_CXX_FLAGS_INIT CMAKE_SHARED_LINKER_FLAGS_INIT CMAKE_EXE_LINKER_FLAGS_INIT)
        string(APPEND ${flag} "${_mmfg_arch_flag}")
    endforeach()
endif()
